#!/bin/bash

# helpers must be sourced before _common.sh: _common.sh calls ynh_read_manifest,
# which is only defined once the real YunoHost helpers are loaded. Sourcing
# _common.sh first leaves app_version silently empty.
source /usr/share/yunohost/helpers
source _common.sh

ynh_script_progression "Stopping $app's systemd service..."

ynh_systemctl --service="$app" --action="stop" --log_path="systemd"

ynh_script_progression "Upgrading source files..."

# Replace code wholesale but keep .env, which carries generated DB credentials,
# and .env.oauth, which carries whatever OAuth registration the operator entered
# by hand. The second one is kept here AND never re-rendered below, which is the
# pair of properties .env does not have: ynh_config_add rewrites .env from the
# template two steps down, so anything hand-added to it does not survive an
# upgrade. See scripts/_common.sh's conduit_ensure_oauth_env.
ynh_setup_source --dest_dir="$install_dir" --keep=".env .env.oauth"

chown -R "$app:www-data" "$install_dir"

ynh_script_progression "Upgrading Node.js runtime dependencies..."

pushd "$install_dir" || ynh_die "Could not enter $install_dir"
    ynh_hide_warnings ynh_exec_as_app npm ci --omit=dev --no-audit --no-fund
popd || ynh_die "Could not leave $install_dir"

ynh_script_progression "Ensuring $app's mail credential key exists..."

# The key arrived in 0.5.0, so anything upgraded from 0.4.x reaches this line
# without one. See scripts/install for what the file is and why no MAIL_KEY_PATH
# accompanies it.
#
# The [ -f ] guard exists so an upgrade never OVERWRITES a key that is
# already in place. Every stored IMAP/SMTP password is sealed under this
# exact key, and mail-crypto.ts cannot distinguish a rotated key from a
# tampered ciphertext -- so overwriting a key still in use would silently
# strand every configured mail account, with each one failing to decrypt at
# its next sync.
#
# Minting a key when one is absent is deliberate, not a gap in that
# guarantee: it covers a fresh data_dir (nothing to strand) and a key that
# was already lost before this upgrade ran. In the lost-key case, the
# stored credentials were already unrecoverable -- nothing here makes that
# worse -- so the operator's job is to have each user re-enter their mail
# password once, not to restore the key (that is still the right move if a
# backup with the matching key exists). Either way, any ciphertext this new
# key cannot open surfaces to the caller as a typed 409, not a crash.
if [ ! -f "$data_dir/mail.key" ]; then
    openssl rand -out "$data_dir/mail.key" 32
    chmod 600 "$data_dir/mail.key"
    chown "$app:$app" "$data_dir/mail.key"
fi

ynh_script_progression "Updating $app's configuration..."

ynh_config_add --template=".env" --destination="$install_dir/.env"
chmod 400 "$install_dir/.env"
chown "$app:$app" "$install_dir/.env"

# The OAuth file arrived in 1.7.0, so anything upgraded from 1.6.x reaches this
# line without one. Creating it is how the operator discovers the feature
# exists; the [ -f ] guard inside is what stops this line undoing their edits on
# the NEXT upgrade, which is the failure this whole arrangement exists to
# prevent.
conduit_ensure_oauth_env

ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_nginx
ynh_config_add_systemd

yunohost service add "$app" --description="Conduit CRM"

ynh_script_progression "Starting $app's systemd service..."

# Schema migrations run automatically on boot.
ynh_systemctl --service="$app" --action="start" --log_path="systemd" \
    --wait_until="listening on 127.0.0.1"

ynh_script_progression "Upgrade of $app completed"

#!/bin/bash

# helpers must be sourced before _common.sh: _common.sh calls ynh_read_manifest,
# which is only defined once the real YunoHost helpers are loaded. Sourcing
# _common.sh first leaves app_version silently empty.
source /usr/share/yunohost/helpers
source _common.sh

ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir"

chown -R "$app:www-data" "$install_dir"
chown -R "$app:$app" "$data_dir"
chmod 750 "$data_dir"

ynh_script_progression "Generating $app's mail credential key..."

# 32 raw bytes of AES-256-GCM key material, sealing the IMAP/SMTP passwords in
# mail_accounts.credentials_ciphertext (services/mail-crypto.ts, which requires
# exactly KEY_BYTES = 32). Nothing else creates this file: the server reads it
# lazily and answers 503 while it is absent, so an install that skips this step
# fails at the first mail account rather than at boot.
#
# No MAIL_KEY_PATH is added to the .env template: config.ts leaves that env var
# optional and falls back to "$DATA_DIR/mail.key", and the template already
# carries DATA_DIR=__DATA_DIR__ -- so the default already resolves to exactly
# this path, and an explicit entry would be a second copy of it to keep in sync.
#
# The key is written straight into $data_dir, which the block above has already
# set to 750 $app:$app, so no other user can reach the file even in the instant
# before chmod lands.
openssl rand -out "$data_dir/mail.key" 32
chmod 600 "$data_dir/mail.key"
chown "$app:$app" "$data_dir/mail.key"

ynh_script_progression "Installing Node.js runtime dependencies..."

# The tarball ships compiled JS and built assets; only runtime deps are fetched.
# No TypeScript or Vite build runs on the server.
pushd "$install_dir" || ynh_die "Could not enter $install_dir"
    ynh_hide_warnings ynh_exec_as_app npm ci --omit=dev --no-audit --no-fund
popd || ynh_die "Could not leave $install_dir"

ynh_script_progression "Adding $app's configuration..."

ynh_config_add --template=".env" --destination="$install_dir/.env"
chmod 400 "$install_dir/.env"
chown "$app:$app" "$install_dir/.env"

ynh_script_progression "Adding system configurations related to $app..."

ynh_config_add_nginx
ynh_config_add_systemd

yunohost service add "$app" --description="Conduit CRM"

ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start" --log_path="systemd" \
    --wait_until="listening on 127.0.0.1"

ynh_script_progression "Installation of $app completed"

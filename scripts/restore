#!/bin/bash

# helpers must be sourced before _common.sh: _common.sh calls ynh_read_manifest,
# which is only defined once the real YunoHost helpers are loaded. Sourcing
# _common.sh first leaves app_version silently empty.
source /usr/share/yunohost/helpers
source ../settings/scripts/_common.sh

ynh_script_progression "Restoring the app main directory..."

ynh_restore "$install_dir"
chown -R "$app:www-data" "$install_dir"
chmod 400 "$install_dir/.env"
chown "$app:$app" "$install_dir/.env"

# .env.oauth needs no line to be BACKED UP -- scripts/backup takes "$install_dir"
# whole rather than enumerating paths inside it, so it rides along with .env.
# What it needs is the same mode re-assertion, and a guard: a backup taken
# before 1.7.0 has no such file, and an install restored from one has no OAuth
# registration to protect. conduit_ensure_oauth_env does both -- it creates the
# commented template when it is absent and asserts 400 either way, which is
# exactly what a restore wants.
conduit_ensure_oauth_env

ynh_script_progression "Restoring the data directory..."

ynh_restore "$data_dir"
chown -R "$app:$app" "$data_dir"
chmod 750 "$data_dir"

# mail.key needs no line of its own to be *backed up* -- scripts/backup takes
# "$data_dir" whole rather than enumerating paths inside it, so the key rides
# along with the blobs the same way. Two things still need saying here:
#
#  - Its mode is re-asserted rather than trusted, the same way .env's 400 is
#    re-asserted above. The chmod 750 on the line above is not recursive, so it
#    does not touch the key; this is about not depending on the archive to have
#    carried a 600 through.
#  - A backup taken before 0.5.0 has no key in it at all. Minting one here is
#    safe precisely in that case and only in that case: such a backup restores
#    a database with no mail accounts in it, so there are no ciphertexts for a
#    fresh key to strand. Without this the app would restore into a permanent
#    503 on every mail route until someone thought to run an upgrade.
if [ -f "$data_dir/mail.key" ]; then
    chmod 600 "$data_dir/mail.key"
else
    openssl rand -out "$data_dir/mail.key" 32
    chmod 600 "$data_dir/mail.key"
    chown "$app:$app" "$data_dir/mail.key"
fi

ynh_script_progression "Restoring the PostgreSQL database..."

ynh_psql_db_shell < ./db.sql

ynh_script_progression "Restoring system configurations related to $app..."

ynh_restore "/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_restore "/etc/systemd/system/$app.service"
systemctl daemon-reload
systemctl enable "$app.service" --quiet

yunohost service add "$app" --description="Conduit CRM"

ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start" --log_path="systemd" \
    --wait_until="listening on 127.0.0.1"

ynh_systemctl --service=nginx --action=reload

ynh_script_progression "Restoration completed for $app"

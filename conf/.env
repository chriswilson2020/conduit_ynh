NODE_ENV=production
PORT=__PORT__
DATABASE_URL=postgres://__DB_USER__:__DB_PWD__@127.0.0.1:5432/__DB_NAME__
BASE_PATH=__PATH__
APP_VERSION=__APP_VERSION__
WEB_ROOT=__INSTALL_DIR__/web
DATA_DIR=__DATA_DIR__

# Mail OAuth (Microsoft / Google) is NOT configured here. This file is a
# template and is regenerated on every upgrade, so anything added to it is
# silently lost the next time Conduit is upgraded. Those settings go in
# .env.oauth beside this file, which the packaging creates once and never
# rewrites. See docs/mail-oauth-setup.md.
